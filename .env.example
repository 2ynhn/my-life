# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
# Vercel 에는 Project → Settings → Environment Variables 에 같은 이름으로 넣습니다.

# 세션 쿠키 서명용 무작위 문자열 (PowerShell 생성 명령은 README 참고)
AUTH_SECRET=

# GCP → Google 인증 플랫폼 → 클라이언트 (웹 애플리케이션)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OAuth Playground 에서 Drive 소유자 계정으로 받은 refresh_token
GOOGLE_DRIVE_REFRESH_TOKEN=

# my-life 폴더 ID (drive.google.com/drive/folders/<ID>)
DRIVE_ROOT_FOLDER_ID=1HDacIWhVrCTSDOKq6TZS5ziK7jLE9QqY

# 로그인 허용 이메일 (쉼표로 구분)
OWNER_EMAILS=bmgassi@gmail.com
GUEST_EMAILS=

# ── 로컬 개발 전용 (production 빌드에서는 무시됨) ──
# Drive 대신 로컬 폴더를 읽어서 화면 확인
# DEV_LOCAL_DRIVE_DIR=./sample-drive
# 구글 로그인 없이 이 이메일로 로그인한 것처럼 동작
# DEV_FAKE_USER=bmgassi@gmail.com
