# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
# Vercel 에는 Project → Settings → Environment Variables 에 같은 이름으로 넣습니다.

# 로그인 쿠키(그 안의 Drive 토큰 포함) 암호화 키. 새면 쿠키를 풀 수 있으니 절대 공유하지 마세요.
# PowerShell 생성 명령은 README 참고
AUTH_SECRET=

# GCP → Google 인증 플랫폼 → 클라이언트 (웹 애플리케이션)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── 로컬 개발 전용 (production 빌드에서는 무시됨) ──
# 가짜 Drive 서버(npm run fake-drive)를 쓰면 구글 로그인 없이 여러 사람을 시험할 수 있다
# DEV_GOOGLE_API_BASE=http://localhost:4010
# DEV_FAKE_USER=me@example.com
